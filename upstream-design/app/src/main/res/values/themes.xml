<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns every colour inside the app (ui/theme/Theme.kt). This XML theme
      only covers the window frame drawn before the first Compose frame, so it is
      deliberately a platform theme with no AppCompat / Material Components dependency.
    -->
    <style name="Theme.Repland.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/repland_window_background</item>
        <item name="android:colorPrimary">@color/repland_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Repland" parent="Theme.Repland.Base" />
</resources>
